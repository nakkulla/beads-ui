        "receipt": "actual-effort"
      },
      "implement-codex": {
        "auto": "orchestrator-or-runtime-model-default",
        "explicit": "catalog-validated",
        "receipt": "actual-effort"
      }
    },
    "effort_catalog": {
      "claude": [
        "low",
        "medium",
        "high",
        "xhigh"
      ],
      "codex": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ]
    },
    "runtime_transports": {
      "codex": {
        "codex": {
          "dispatch": "codex-native-spawn",
          "receipt": "spawn-agent"
        },
        "claude": {
          "dispatch": "implement-claude",
          "receipt": "implement-claude"
        }
      },
      "claude": {
