{
  "schema_version": 1,
  "workflow_mode_default": "standard",
  "review": {
    "default": "astra",
    "reviewers": {
      "codex": {
        "model": "sol",
        "effort": "xhigh"
      },
      "astra": {
        "model": "astra",
        "effort": "xhigh"
      },
      "opus": {
        "model": "opus",
        "effort": "high"
      },
      "fable": {
        "model": "fable",
        "effort": "high"
      },
      "neon": {
        "model": "neon",
        "effort": "xhigh"
      }
    },
    "runtime_transports": {
      "claude": {
        "codex": "codex-runner-bridge",
        "astra": "codex-runner-bridge",
        "opus": "claude-agent-readonly",
        "fable": "claude-agent-readonly",
        "neon": "agy-runner"
      },
      "codex": {
        "codex": "codex-native-spawn",
        "astra": "codex-native-spawn",
        "opus": "claude-runner",
        "fable": "claude-runner",
        "neon": "agy-runner"
      },
      "agy": {
        "codex": "codex-runner-bridge",
        "astra": "codex-runner-bridge",
        "opus": "claude-runner",
        "fable": "claude-runner",
        "neon": "agy-runner"
      }
    }
  },
  "plan_review": {
    "standard_recommended": "astra",
    "fast_track_default": "astra"
  },
  "implementation": {
    "default": {
      "runtime": "codex",
      "model": "sol",
      "effort": "auto",
      "speed": "default",
      "dispatch": "delegated"
    },
    "route_defaults": {
      "quick_fix": {
        "dispatch": "main"
      }
    },
    "model_catalog": {
      "claude": [
        "opus",
        "fable",
        "sonnet",
        "haiku"
      ],
      "codex": {
        "families": [
          "astra",
          "sol",
          "terra",
          "luna"
        ],
        "resolve": "codex_cli_latest_v2"
      },
      "agy": {
        "families": [
          "neon",
          "carbon",
          "argon",
          "hydrogen"
        ],
        "resolve": "agy_cli_models"
      }
    },
    "exact_model_default_effort": {
      "claude_runner": "high",
      "codex": "runtime_model_default"
    },
    "effort_by_transport": {
      "claude-native-agent": {
        "auto": "agent-type",
        "explicit": "agent-type",
        "receipt": "actual-effort"
      },
      "implement-claude": {
        "auto": "claude-runner-model-default",
        "explicit": "catalog-validated",
        "receipt": "actual-effort"
      },
      "codex-native-spawn": {
        "auto": "orchestrator-or-runtime-model-default",
        "explicit": "catalog-validated",
        "receipt": "actual-effort"
      },
      "implement-codex": {
        "auto": "orchestrator-or-runtime-model-default",
        "explicit": "catalog-validated",
        "receipt": "actual-effort"
      },
      "implement-agy": {
        "auto": "orchestrator-or-runtime-model-default",
        "explicit": "catalog-validated",
        "receipt": "actual-effort"
      }
    },
    "effort_catalog": {
      "claude": [
        "low",
        "medium",
        "high",
        "xhigh"
      ],
      "codex": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ],
      "agy": [
        "low",
        "medium",
        "high",
        "xhigh"
      ]
    },
    "runtime_transports": {
      "codex": {
        "codex": {
          "dispatch": "codex-native-spawn",
          "receipt": "spawn-agent"
        },
        "claude": {
          "dispatch": "implement-claude",
          "receipt": "implement-claude"
        },
        "agy": {
          "dispatch": "implement-agy",
          "receipt": "implement-agy"
        }
      },
      "claude": {
        "claude": {
          "dispatch": "claude-native-agent",
          "receipt": "native-agent"
        },
        "codex": {
          "dispatch": "implement-codex",
          "receipt": "implement-codex"
        },
        "agy": {
          "dispatch": "implement-agy",
          "receipt": "implement-agy"
        }
      },
      "agy": {
        "claude": {
          "dispatch": "implement-claude",
          "receipt": "implement-claude"
        },
        "codex": {
          "dispatch": "implement-codex",
          "receipt": "implement-codex"
        },
        "agy": {
          "dispatch": "implement-agy",
          "receipt": "implement-agy"
        }
      }
    },
    "speeds": [
      "default",
      "fast"
    ],
    "speed_by_transport": {
      "codex-native-spawn": {
        "default": "omitted",
        "fast": "priority"
      },
      "implement-codex": {
        "default": "default",
        "fast": "fast"
      }
    },
    "auto_pool_defaults": {
      "claude": {
        "models": [
          "sonnet",
          "opus"
        ],
        "effort": {
          "min": "medium",
          "max": "xhigh"
        }
      },
      "codex": {
        "models": [
          "terra",
          "sol"
        ],
        "effort": {
          "min": "medium",
          "max": "xhigh"
        }
      },
      "agy": {
        "models": [
          "carbon",
          "neon"
        ],
        "effort": {
          "min": "medium",
          "max": "high"
        }
      }
    }
  }
}
