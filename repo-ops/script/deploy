#!/bin/sh
set -eu

fail() {
    printf 'repo-ops deploy: %s\n' "$*" >&2
    exit 1
}

# The Worker gives this script no stdin, and a question would hang the operation
# until its timeout. Closing stdin makes that a loud failure instead.
exec </dev/null

: "${REPO_OPS_TARGET_SHA:?REPO_OPS_TARGET_SHA is required}"
: "${REPO_OPS_TARGET_BASE:?REPO_OPS_TARGET_BASE is required}"
: "${REPO_OPS_REPO_ROOT:?REPO_OPS_REPO_ROOT is required}"

case "$REPO_OPS_TARGET_SHA" in
    *[!0-9a-f]*|'') fail "REPO_OPS_TARGET_SHA must be a lowercase hex SHA" ;;
esac
[ "${#REPO_OPS_TARGET_SHA}" -eq 40 ] || fail "REPO_OPS_TARGET_SHA must be 40 hex characters"

repo_root="$(cd "$REPO_OPS_REPO_ROOT" && pwd -P)" || fail "REPO_OPS_REPO_ROOT is unavailable"
cwd="$(pwd -P)"
[ "$cwd" = "$repo_root" ] || fail "cwd must equal REPO_OPS_REPO_ROOT"

# Re-exec this script while a Python-owned flock descriptor remains inherited by
# the shell and every child it launches. macOS has no flock(1), so fcntl.flock
# is the one portable protocol shared with the Worker coordinator.
#
# The lockfile path is spelled as one literal because the contract's activation
# gate decides a script is lock-capable by searching its bytes for
# `.worktrees/.repo-ops-deploy.lock`; assembling the path from segments keeps the
# gate shut even though the resolved path is identical.
if [ "${REPO_OPS_DEPLOY_LOCKED:-}" != "1" ]; then
    common_dir="$(git -C "$repo_root" rev-parse --path-format=absolute --git-common-dir)" ||
        fail "cannot resolve the main repository directory"
    lock_file="$(dirname "$common_dir")/.worktrees/.repo-ops-deploy.lock"
    exec python3 -c '
import fcntl
import os
import sys

script = sys.argv[1]
lock_file = sys.argv[2]
os.makedirs(os.path.dirname(lock_file), exist_ok=True)
fd = os.open(lock_file, os.O_CREAT | os.O_RDWR, 0o600)
fcntl.flock(fd, fcntl.LOCK_EX)
os.set_inheritable(fd, True)
env = dict(os.environ)
env["REPO_OPS_DEPLOY_LOCKED"] = "1"
os.execve(script, [script, *sys.argv[3:]], env)
' "$0" "$lock_file" "$@"
fi

# The restart marker is this deploy's only durable trace for a consumer that
# never saw the operation. It lives beside the lockfile, under the same owner
# root; the lock branch above resolved that root before the re-exec, so the
# locked body resolves it again.
marker_common_dir="$(git -C "$repo_root" rev-parse --path-format=absolute --git-common-dir)" ||
    fail "cannot resolve the main repository directory"
marker_dir="$(dirname "$marker_common_dir")/.worktrees"
marker_file="$marker_dir/.repo-ops-deploy.restart.json"
marker_started=0
marker_started_at=0
marker_result='failed'
marker_instance_id=''

# A reader may open this file at any moment, so every write lands atomically
# through a same-directory temp file.
write_marker() {
    mkdir -p "$marker_dir" || return 1
    marker_tmp="$marker_file.tmp.$$"
    printf '%s\n' "$1" >"$marker_tmp" || return 1
    mv -f "$marker_tmp" "$marker_file" || return 1
}

# `$?` must be read before anything else runs: only an exit-0 script deployed,
# so a failure after the success flag is set still records `failed`.
finish_marker() {
    marker_exit_status=$?
    [ "$marker_started" -eq 1 ] || return "$marker_exit_status"
    if [ "$marker_exit_status" -eq 0 ] && [ "$marker_result" = 'ok' ] &&
        [ -n "$marker_instance_id" ]; then
        write_marker "{\"schema\": 1, \"target_sha\": \"$REPO_OPS_TARGET_SHA\", \"target_base\": \"$REPO_OPS_TARGET_BASE\", \"started_at\": $marker_started_at, \"result\": \"ok\", \"instance_id\": \"$marker_instance_id\", \"finished_at\": $(date +%s)000}" || true
    else
        write_marker "{\"schema\": 1, \"target_sha\": \"$REPO_OPS_TARGET_SHA\", \"target_base\": \"$REPO_OPS_TARGET_BASE\", \"started_at\": $marker_started_at, \"result\": \"failed\", \"finished_at\": $(date +%s)000}" || true
    fi
    return "$marker_exit_status"
}

read_head() {
    git -C "$repo_root" rev-parse --verify HEAD^{commit}
}

start_head="$(read_head)" || fail "cannot read start HEAD"
[ "$start_head" = "$REPO_OPS_TARGET_SHA" ] || fail "start HEAD differs from REPO_OPS_TARGET_SHA"

npm ci || fail "npm ci failed"
npm run build || fail "npm run build failed"

# POSIX sh has no millisecond clock, and these timestamps are diagnostic only:
# the consumer judges on instance identity, never on time.
marker_started_at="$(date +%s)000"
write_marker "{\"schema\": 1, \"target_sha\": \"$REPO_OPS_TARGET_SHA\", \"target_base\": \"$REPO_OPS_TARGET_BASE\", \"started_at\": $marker_started_at}" ||
    fail "cannot write the restart marker"
marker_started=1
trap finish_marker EXIT

# The restart kills the server this operation was launched from. The one-shot
# executor is detached precisely so it outlives that and still records the exit
# code and log marker below.
bdui-shared restart || fail "bdui-shared restart failed"

# Health identity is the whole success condition: the live process must report
# THIS target SHA and must be running out of THIS worktree. Anything else means
# the restart brought back a different source, which is not a deploy.
health_url="${BDUI_DEPLOY_HEALTH_URL:-}"
if [ -z "$health_url" ]; then
    health_host="${BDUI_HOST:-}"
    if [ -z "$health_host" ] && command -v ts-ip >/dev/null 2>&1; then
        health_host="$(ts-ip 2>/dev/null || true)"
    fi
    [ -n "$health_host" ] || health_host="127.0.0.1"
    health_url="http://${health_host}:3000/healthz"
fi

HEALTH_ATTEMPTS="${REPO_OPS_HEALTH_ATTEMPTS:-60}"
HEALTH_POLL_SECONDS="${REPO_OPS_HEALTH_POLL_SECONDS:-1}"

# Node is a hard dependency of this repo, so the readback parses the health JSON
# and resolves the reported repo path with it rather than adding jq/curl to the
# contract. It prints nothing but `ok` or a stable reason.
health_probe() {
    REPO_OPS_HEALTH_URL="$health_url" \
    REPO_OPS_EXPECT_SHA="$REPO_OPS_TARGET_SHA" \
    REPO_OPS_EXPECT_ROOT="$repo_root" \
    node --input-type=module -e '
import fs from "node:fs";
const url = process.env.REPO_OPS_HEALTH_URL;
const expect_sha = process.env.REPO_OPS_EXPECT_SHA;
const expect_root = process.env.REPO_OPS_EXPECT_ROOT;
// The caller pins the identity of the first target-SHA runtime it sees, so
// every verdict from that point on carries the id. The reason word itself must
// stay byte-identical because the shell surfaces it verbatim.
let instance_id = "";
function report(reason) {
  process.stdout.write(instance_id ? `${reason} ${instance_id}` : reason);
  process.exit(0);
}
let body = null;
try {
  const response = await fetch(url, {
    headers: { accept: "application/json" },
    signal: AbortSignal.timeout(2000)
  });
  body = response.ok ? await response.json() : null;
} catch {
  body = null;
}
const runtime = body && typeof body === "object" ? body.runtime : null;
if (!runtime || typeof runtime !== "object") {
  report("unreachable");
}
if (runtime.source_sha !== expect_sha) {
  report("source_sha_mismatch");
}
// The verdict is a single whitespace-separated token pair, so an id outside
// this alphabet cannot be carried at all. An uncarried id proves nothing, and
// `ok` exists only for the instance the end marker will name, so a runtime that
// reports no usable id is never healthy for this deploy.
if (
  typeof runtime.instance_id !== "string" ||
  !/^[A-Za-z0-9._-]{1,128}$/.test(runtime.instance_id)
) {
  report("runtime_identity_missing");
}
instance_id = runtime.instance_id;
let resolved = null;
try {
  resolved = fs.realpathSync(String(runtime.source_repo || ""));
} catch {
  resolved = null;
}
if (resolved !== expect_root) {
  report("source_repo_mismatch");
}
// Identity alone would let a bd JSON compatibility regression deploy green:
// the process is the right code, but it can no longer read what bd emits. The
// same body must therefore also show a healthy bd protocol boundary.
const diagnostics = body.diagnostics;
const bd = diagnostics && typeof diagnostics === "object" ? diagnostics.bd : null;
if (!bd || typeof bd !== "object") {
  report("bd_diagnostics_missing");
}
if (typeof bd.version !== "string" || bd.version.length === 0) {
  report("bd_diagnostics_version_missing");
}
const observations = bd.producer_observations;
if (!observations || typeof observations !== "object") {
  report("bd_diagnostics_observations_missing");
}
for (const mode of ["default", "envelope_opt_in"]) {
  const observed = observations[mode];
  if (!observed || typeof observed !== "object" || typeof observed.format !== "string") {
    report("bd_diagnostics_observation_unhealthy");
  }
}
const supported = Array.isArray(bd.consumer_supported_formats) ? bd.consumer_supported_formats : [];
for (const required of ["bare", "envelope_v2"]) {
  if (!supported.includes(required)) {
    report("bd_consumer_support_missing");
  }
}
const workspace_probe = bd.workspace_probe;
if (!workspace_probe || typeof workspace_probe !== "object" || workspace_probe.ok !== true) {
  report("bd_workspace_probe_red");
}
const failures = bd.active_protocol_failures;
if (!failures || typeof failures !== "object" || failures.workspace_count !== 0) {
  report("bd_protocol_failure_active");
}
report("ok");
'
}

# The first target-SHA runtime this poll observes is the one whose `ok` counts.
# Pinning its id is what makes the end marker provable: a manual restart or a
# crash reboot mid-poll answers with a different id and fails the deploy instead
# of certifying a runtime this script never brought up.
attempt=0
probe_reason="unreachable"
probe_instance=""
pinned_instance_id=""
while [ "$attempt" -lt "$HEALTH_ATTEMPTS" ]; do
    probe_output="$(health_probe)" || probe_output="unreachable"
    probe_reason="${probe_output%% *}"
    case "$probe_output" in
        *' '*) probe_instance="${probe_output#* }" ;;
        *) probe_instance="" ;;
    esac
    if [ -n "$probe_instance" ]; then
        if [ -z "$pinned_instance_id" ]; then
            pinned_instance_id="$probe_instance"
        elif [ "$probe_instance" != "$pinned_instance_id" ]; then
            fail "runtime health readback failed: runtime_identity_changed"
        fi
    fi
    if [ "$probe_reason" = "ok" ]; then
        [ -n "$probe_instance" ] ||
            fail "runtime health readback failed: runtime_identity_missing"
        break
    fi
    attempt=$((attempt + 1))
    sleep "$HEALTH_POLL_SECONDS"
done
[ "$probe_reason" = "ok" ] || fail "runtime health readback failed: $probe_reason"
marker_instance_id="$pinned_instance_id"

end_head="$(read_head)" || fail "cannot read end HEAD"
[ "$end_head" = "$REPO_OPS_TARGET_SHA" ] || fail "end HEAD differs from REPO_OPS_TARGET_SHA"
end_status="$(git -C "$repo_root" status --porcelain --untracked-files=all)" || fail "cannot read end worktree status"
[ -z "$end_status" ] || fail "worktree is not tracked-clean"

marker_result='ok'

printf 'repo-ops deploy ok: base=%s target=%s\n' "$REPO_OPS_TARGET_BASE" "$REPO_OPS_TARGET_SHA"
